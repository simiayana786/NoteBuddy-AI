                        Generate Slides
                    </button>


                    <div
                        id="slidesStatus"
                        style="
                            margin-top:12px;
                            display:none;
                            text-align:left;
                            color:#111;
                            background:#f8fafc;
                            padding:12px;
                            border-radius:12px;
                        "
                    >

                        <p id="slidesMessage"></p>


                        <div
                            id="paymentBox"
                            style="
                                display:none;
                                margin-top:12px;
                                background:#fff7ed;
                                padding:12px;
                                border-radius:12px;
                                color:#111;
                                text-align:center;
                            "
                        >

                            <p
                                style="
                                    font-weight:600;
                                    margin-bottom:8px;
                                "
                            >
                                Pay ₹499 to unlock download
                            </p>


                            <div
                                style="
                                    width:140px;
                                    height:140px;
                                    margin:0 auto;
                                    border:2px dashed #f59e0b;
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;
                                    font-size:12px;
                                    color:#92400e;
                                "
                            >
                                QR Placeholder
                            </div>


                            <p
                                style="
                                    margin-top:8px;
                                    font-size:13px;
                                "
                            >
                                Scan to pay and then confirm below.
                            </p>


                            <button
                                id="payToDownloadBtn"
                                style="
                                    margin-top:10px;
                                    width:100%;
                                "
                            >
                                Pay ₹499 to Download Slides
                            </button>

                        </div>


                        <a
                            id="slidesDownloadLink"
                            style="
                                display:none;
                                color:#2563eb;
                                text-decoration:underline;
                                cursor:pointer;
                                margin-top:10px;
                            "
                        >
                            Download slides
                        </a>

                    </div>

                </div>

            </div>


            <!-- RECENT PROJECTS -->

            <div class="section">

                <h2>
                    Recent Projects
                </h2>

                <br>


                <div class="project">

                    <span>
                        Operating Systems Lecture
                    </span>

                    <button>
                        Open
                    </button>

                </div>


                <div class="project">

                    <span>
                        Hackathon Meeting
                    </span>

                    <button>
                        Open
                    </button>

                </div>


                <div class="project">

                    <span>
                        AI Seminar
                    </span>

                    <button>
                        Open
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>


<script>
    /* =========================
   LOGIN
========================= */

function login() {

    const email =
        document.getElementById("email").value.trim();

    const password =
        document.getElementById("password").value.trim();

    if (email === "" || password === "") {

        alert("Please enter Email and Password");

        return;
    }

    localStorage.setItem("user", email);

    document.getElementById("loginPage").style.display = "none";

    document.getElementById("dashboard").style.display = "block";

    document.getElementById("userName").textContent = email;
}


/* =========================
   LOGOUT
========================= */

function logout() {

    localStorage.removeItem("user");

    location.reload();
}


/* =========================
   RECORDING VARIABLES
========================= */

let mediaRecorder = null;

let audioChunks = [];

let timerInterval = null;

let timerSeconds = 0;


/* =========================
   TIMER
========================= */

function updateTimer() {

    const minutes =
        String(Math.floor(timerSeconds / 60))
        .padStart(2, "0");

    const seconds =
        String(timerSeconds % 60)
        .padStart(2, "0");

    document.getElementById("recTimer").textContent =
        `${minutes}:${seconds}`;
}


function resetTimer() {

    clearInterval(timerInterval);

    timerSeconds = 0;

    updateTimer();
}


/* =========================
   START RECORDING
========================= */

function startRecording() {

    const startButton =
        document.getElementById("startRec");

    const stopButton =
        document.getElementById("stopRec");

    const downloadLink =
        document.getElementById("downloadLink");


    if (!navigator.mediaDevices ||
        !navigator.mediaDevices.getUserMedia) {

        alert(
            "Your browser does not support microphone recording."
        );

        return;
    }


    navigator.mediaDevices
        .getUserMedia({ audio: true })

        .then(function(stream) {

            mediaRecorder =
                new MediaRecorder(stream);

            audioChunks = [];


            mediaRecorder.addEventListener(
                "dataavailable",
                function(event) {

                    if (event.data.size > 0) {

                        audioChunks.push(event.data);
                    }
                }
            );


            mediaRecorder.addEventListener(
                "stop",
                function() {

                    const audioBlob =
                        new Blob(
                            audioChunks,
                            { type: "audio/webm" }
                        );


                    const audioUrl =
                        URL.createObjectURL(audioBlob);


                    downloadLink.href = audioUrl;

                    downloadLink.download =
                        "recording.webm";

                    downloadLink.style.display =
                        "inline-block";

                    downloadLink.textContent =
                        "Download";


                    stream.getTracks().forEach(
                        function(track) {
                            track.stop();
                        }
                    );
                }
            );


            mediaRecorder.start();


            startButton.disabled = true;

            stopButton.disabled = false;

            downloadLink.style.display = "none";


            resetTimer();


            timerInterval =
                setInterval(function() {

                    timerSeconds++;

                    updateTimer();

                }, 1000);

        })

        .catch(function(error) {

            console.error(
                "Microphone access error:",
                error
            );

            alert(
                "Unable to access the microphone. Please allow microphone access in your browser."
            );
        });
}


/* =========================
   STOP RECORDING
========================= */

function stopRecording() {

    if (
        mediaRecorder &&
        mediaRecorder.state !== "inactive"
    ) {

        mediaRecorder.stop();
    }


    clearInterval(timerInterval);


    document.getElementById(
        "startRec"
    ).disabled = false;


    document.getElementById(
        "stopRec"
    ).disabled = true;
}


/* =========================
   NOTES VARIABLES
========================= */

let lastNotes = [];


/* =========================
   PREPARE NOTES
========================= */

function prepareNotes() {

    const fileInput =
        document.getElementById(
            "audioFileInput"
        );

    const notesPanel =
        document.getElementById(
            "notesPanel"
        );

    const notesOutput =
        document.getElementById(
            "notesOutput"
        );


    const file =
        fileInput.files[0];


    if (!file) {

        alert(
            "Please select an audio file first."
        );

        return;
    }


    notesPanel.style.display = "block";


    notesOutput.innerHTML =
        "<p>Analyzing uploaded audio and preparing draft notes...</p>";


    const reader =
        new FileReader();


    reader.onload = function() {

        const sizeKb =
            (file.size / 1024).toFixed(1);


        notesOutput.innerHTML = `

            <p>
                <strong>File:</strong>
                ${file.name}
            </p>

            <p>
                <strong>Size:</strong>
                ${sizeKb} KB
            </p>

            <p>
                <strong>Duration:</strong>
                Unknown
            </p>

            <h4 style="margin-top:14px;">
                Draft Notes
            </h4>

            <ul style="margin-left:18px;">

                <li>
                    The audio file has been uploaded.
                </li>

                <li>
                    Summary highlights are prepared.
                </li>

                <li>
                    Next steps and action items are listed clearly.
                </li>

            </ul>

            <p style="margin-top:14px;">
                Click "Generate Notes" to finalize notes.
            </p>
        `;
    };


    reader.readAsArrayBuffer(file);
}


/* =========================
   GENERATE NOTES
========================= */

function generateNotes() {

    const fileInput =
        document.getElementById(
            "audioFileInput"
        );

    const notesPanel =
        document.getElementById(
            "notesPanel"
        );

    const notesOutput =
        document.getElementById(
            "notesOutput"
        );


    const file =
        fileInput.files[0];


    if (!file) {

        alert(
            "Please upload an audio file before generating notes."
        );

        return;
    }


    notesPanel.style.display = "block";


    notesOutput.innerHTML =
        "<p>Generating final notes from uploaded audio...</p>";


    setTimeout(function() {

        const sizeKb =
            (file.size / 1024).toFixed(1);


        const summary = [

            "Key topic: Product pitch and go-to-market plan.",

            "Action item: Follow up with design and finance teams.",

            "Decision: Move to prototype phase with MVP scope.",

            "Next step: Schedule the next review session in 2 days."

        ];


        lastNotes = [

            "Slide 1: Product pitch and value proposition",

            "Slide 2: Key takeaways and target audience",

            "Slide 3: Action items and responsibilities",

            "Slide 4: Timeline and next milestones",

            "Slide 5: Summary and follow-up plan"

        ];


        notesOutput.innerHTML = `

            <p>
                <strong>File:</strong>
                ${file.name}
            </p>

            <p>
                <strong>Size:</strong>
                ${sizeKb} KB
            </p>

            <h4 style="margin-top:14px;">
                Final Notes
            </h4>

            <ul style="margin-left:18px;">

                ${summary
                    .map(function(line) {
                        return `<li>${line}</li>`;
                    })
                    .join("")
                }

            </ul>

            <p style="margin-top:14px;">
                These notes are now ready to drive slide creation.
            </p>
        `;

    }, 900);
}


/* =========================
   CREATE SLIDES
========================= */

function createSlides() {

    const statusBox =
        document.getElementById(
            "slidesStatus"
        );

    const statusMessage =
        document.getElementById(
            "slidesMessage"
        );

    const downloadLink =
        document.getElementById(
            "slidesDownloadLink"
        );

    const paymentBox =
        document.getElementById(
            "paymentBox"
        );

    const payButton =
        document.getElementById(
            "payToDownloadBtn"
        );


    statusBox.style.display = "block";

    statusMessage.textContent =
        "Preparing slides from your latest recording...";

    downloadLink.style.display =
        "none";


    const duration =
        timerSeconds > 0
            ? `${Math.floor(timerSeconds / 60)}:${String(
                timerSeconds % 60
            ).padStart(2, "0")}`
            : "unknown";


    const content =
        lastNotes.length
            ? lastNotes
            : [

                "Slide 1: Meeting Overview",

                `Slide 2: Recording duration ${duration}`,

                "Slide 3: Key Points",

                "Slide 4: Action Items",

                "Slide 5: Next Steps"

            ];


    const html = `

<!DOCTYPE html>

<html>

<head>

<meta charset="UTF-8">

<title>Generated Slides</title>

<style>

body {

    font-family: Arial, sans-serif;

    background: #f4f7fb;

    color: #111;

    padding: 40px;
}

.slide {

    border: 1px solid #ccc;

    border-radius: 16px;

    padding: 24px;

    margin-bottom: 20px;

    background: white;

    box-shadow:
        0 10px 30px rgba(0,0,0,0.08);
}

h1 {

    margin-top: 0;

    color: #1f2937;
}

h2 {

    margin-bottom: 12px;

    color: #111;
}

</style>

</head>

<body>

<h1>Generated Slides</h1>

${content.map(function(item) {

    const parts =
        item.split(":");

    const title =
        parts.shift();

    const description =
        parts.join(":").trim()
        || "Summary content goes here.";

    return `

        <div class="slide">

            <h2>
                ${title}
            </h2>

            <p>
                ${description}
            </p>

        </div>
    `;

}).join("")}

</body>

</html>
`;


    const blob =
        new Blob(
            [html],
            { type: "text/html" }
        );


    const url =
        URL.createObjectURL(blob);


    downloadLink.href = url;

    downloadLink.download =
        "generated_slides.html";

    downloadLink.textContent =
        "Download slides";


    paymentBox.style.display =
        "block";


    payButton.style.display =
        "inline-block";


    payButton.disabled =
        false;


    payButton.textContent =
        "Pay ₹499 to Download Slides";


    payButton.onclick =
        function() {

            handlePayment(url);
        };


    statusMessage.textContent =
        "Slides are ready. Pay ₹499 to unlock the download.";
}


/* =========================
   PAYMENT DEMO
========================= */

function handlePayment(downloadUrl) {

    const statusMessage =
        document.getElementById(
            "slidesMessage"
        );

    const payButton =
        document.getElementById(
            "payToDownloadBtn"
        );

    const downloadLink =
        document.getElementById(
            "slidesDownloadLink"
        );

    const paymentBox =
        document.getElementById(
            "paymentBox"
        );


    statusMessage.textContent =
        "Processing payment of ₹499...";


    payButton.disabled = true;

    payButton.textContent =
        "Processing...";


    setTimeout(function() {

        statusMessage.textContent =
            "Payment of ₹499 completed. Your download is ready.";


        paymentBox.style.display =
            "none";


        downloadLink.style.display =
            "inline-block";


        downloadLink.href =
            downloadUrl;


        downloadLink.download =
            "generated_slides.html";


        downloadLink.textContent =
            "Download slides";


        payButton.disabled =
            false;

    }, 1200);
}


/* =========================
   PAGE LOAD
========================= */

window.addEventListener(
    "DOMContentLoaded",
    function() {

        const user =
            localStorage.getItem("user");


        document.getElementById(
            "loginPage"
        ).style.display = "none";


        document.getElementById(
            "dashboard"
        ).style.display = "block";


        if (user) {

            document.getElementById(
                "userName"
            ).textContent = user;

        }


        document.getElementById(
            "startRec"
        ).addEventListener(
            "click",
            startRecording
        );


        document.getElementById(
            "stopRec"
        ).addEventListener(
            "click",
            stopRecording
        );


        document.getElementById(
            "generateSlidesBtn"
        ).addEventListener(
            "click",
            createSlides
        );


        document.getElementById(
            "prepareNotesBtn"
        ).addEventListener(
            "click",
            prepareNotes
        );


        document.getElementById(
            "generateNotesBtn"
        ).addEventListener(
            "click",
            generateNotes
        );


        updateTimer();

    }
);

</script>

</body>

</html>
