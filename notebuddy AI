                            Stop
                        </button>

                        <span id="recTimer">
                            00:00
                        </span>

                        <a
                            id="downloadLink"
                            style="
                                display:none;
                                color:#2563eb;
                                text-decoration:underline;
                                cursor:pointer;
                            "
                        >
                            Download
                        </a>

                    </div>

                </div>


                <!-- UPLOAD -->

                <div class="card">

                    <span>📁</span>

                    <h3>
                        Upload Audio
                    </h3>

                    <p>
                        Upload MP3/WAV files.
                    </p>

                    <input
                        id="audioFileInput"
                        type="file"
                        accept="audio/*"
                        style="
                            margin-top:16px;
                            width:100%;
                        "
                    >

                    <button
                        id="prepareNotesBtn"
                        style="
                            margin-top:12px;
                            width:100%;
                        "
                    >
                        Prepare Notes
                    </button>


                    <div
                        id="notesPanel"
                        style="
                            display:none;
                            margin-top:16px;
                            background:#f8fafc;
                            padding:16px;
                            border-radius:14px;
                            color:#111;
                            text-align:left;
                        "
                    >

                        <h4
                            style="
                                margin-bottom:12px;
                                color:#0f172a;
                            "
                        >
                            Generated Notes
                        </h4>

                        <div id="notesOutput"></div>

                    </div>

                </div>


                <!-- GENERATE NOTES -->

                <div class="card">

                    <span>📝</span>

                    <h3>
                        Generate Notes
                    </h3>

                    <p>
                        AI creates clean notes.
                    </p>

                    <button
                        id="generateNotesBtn"
                        style="
                            margin-top:16px;
                            width:100%;
                        "
                    >
                        Generate Notes
                    </button>

                </div>
                                <!-- CREATE SLIDES -->

                <div class="card">

                    <span>📊</span>

                    <h3>
                        Create Slides
                    </h3>

                    <p>
                        Professional PPT in seconds.
                    </p>

                    <button
                        id="generateSlidesBtn"
                        style="
                            margin-top:16px;
                            width:100%;
