<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NoteBuddy AI</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#0f172a;
color:white;
}

.container{
display:flex;
height:100vh;
}

/* Sidebar */

.sidebar{
width:250px;
background:#111827;
padding:30px;
display:flex;
flex-direction:column;
}

.sidebar h2{
margin-bottom:40px;
color:#38bdf8;
}

.sidebar ul{
list-style:none;
}

.sidebar li{
padding:15px;
margin-bottom:10px;
border-radius:10px;
cursor:pointer;
transition:.3s;
}

.sidebar li:hover{
background:#1e293b;
}

/* Main */

.main{
flex:1;
padding:40px;
}

/* Top */

.topbar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:30px;
}

.profile{
background:#38bdf8;
padding:10px 18px;
border-radius:25px;
color:white;
}

/* Cards */

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-bottom:40px;
}

.card{
background:white;
color:#222;
padding:30px;
border-radius:20px;
transition:.3s;
cursor:pointer;
text-align:center;
}

.card:hover{
transform:translateY(-8px);
box-shadow:0 10px 25px rgba(0,0,0,.3);
}

.card span{
font-size:45px;
display:block;
margin-bottom:15px;
}

/* Recent */

.section{
background:white;
color:#222;
padding:25px;
border-radius:20px;
}

.project{
display:flex;
justify-content:space-between;
padding:15px 0;
border-bottom:1px solid #eee;
}

button{
padding:12px 20px;
background:#2563eb;
border:none;
border-radius:10px;
color:white;
cursor:pointer;
font-size:15px;
}

button:hover{
background:#1d4ed8;
}

/* Login */

#loginPage{
display:flex;
justify-content:center;
align-items:center;
height:100vh;
}

.loginCard{

background:white;

color:black;

padding:40px;

width:370px;

border-radius:20px;

text-align:center;

box-shadow:0 20px 40px rgba(0,0,0,.4);

}

.loginCard h1{

margin-bottom:10px;

}

.loginCard p{

color:gray;

margin-bottom:20px;

}

.loginCard input{

width:100%;

padding:14px;

margin:10px 0;

border:1px solid #ddd;

border-radius:10px;

}

.loginCard button{

width:100%;

margin-top:15px;

}

</style>

</head>

<body>

<!-- LOGIN PAGE -->

<div id="loginPage" style="display:none;">

<div class="loginCard">

<h1>🎤 NoteBuddy AI</h1>

<p>Voice → Notes → Slides</p>

<input type="email" id="email" placeholder="Email">

<input type="password" id="password" placeholder="Password">

<button onclick="login()">Login</button>

</div>

</div>

<!-- DASHBOARD -->

<div id="dashboard" style="display:none;">

<div class="container">

<div class="sidebar">

<h2>NoteBuddy AI</h2>

<ul>

<li>🏠 Dashboard</li>

<li>🎤 Record Meeting</li>

<li>📁 Upload Audio</li>

<li>📝 AI Notes</li>

<li>📊 Generate Slides</li>

<li>🔗 Blockchain Verify</li>

<li onclick="logout()">🚪 Logout</li>

</ul>

</div>

<div class="main">

<div class="topbar">

<div>

<h1>Welcome 👋</h1>

<p>Turn your meetings into presentations.</p>

</div>

<div class="profile" id="userName">
User
</div>

</div>

<div class="cards">

<div class="card">

<span>🎤</span>

<h3>Record Meeting</h3>

<p>Capture live meetings instantly.</p>

<div class="recordControls" style="margin-top:16px; display:flex; gap:10px; align-items:center; justify-content:center; flex-wrap:wrap;">
  <button id="startRec">Start</button>
  <button id="stopRec" disabled>Stop</button>
  <span id="recTimer">00:00</span>
  <a id="downloadLink" style="display:none; color:#2563eb; text-decoration:underline; cursor:pointer;">Download</a>
</div>

</div>

<div class="card">

<span>📁</span>

<h3>Upload Audio</h3>

<p>Upload MP3/WAV files.</p>

<input id="audioFileInput" type="file" accept="audio/*" style="margin-top:16px; width:100%;" />
<button id="prepareNotesBtn" style="margin-top:12px; width:100%;">Prepare Notes</button>

<div id="notesPanel" style="display:none; margin-top:16px; background:#f8fafc; padding:16px; border-radius:14px; color:#111; text-align:left;">
  <h4 style="margin-bottom:12px; color:#0f172a;">Generated Notes</h4>
  <div id="notesOutput"></div>
</div>

</div>

<div class="card">

<span>📝</span>

<h3>Generate Notes</h3>

<p>AI creates clean notes.</p>

<button id="generateNotesBtn" style="margin-top:16px; width:100%;">Generate Notes</button>

</div>

<div class="card">

<span>📊</span>

<h3>Create Slides</h3>

<p>Professional PPT in seconds.</p>

<button id="generateSlidesBtn" style="margin-top:16px; width:100%;">Generate Slides</button>

<div id="slidesStatus" style="margin-top:12px; display:none; text-align:left; color:#111; background:#f8fafc; padding:12px; border-radius:12px;">
  <p id="slidesMessage"></p>
  <div id="paymentBox" style="display:none; margin-top:12px; background:#fff7ed; padding:12px; border-radius:12px; color:#111; text-align:center;">
    <p style="font-weight:600; margin-bottom:8px;">Pay ₹499 to unlock download</p>
    <div style="width:140px; height:140px; margin:0 auto; border:2px dashed #f59e0b; display:flex; align-items:center; justify-content:center; font-size:12px; color:#92400e;">QR Placeholder</div>
    <p style="margin-top:8px; font-size:13px;">Scan to pay and then confirm below.</p>
    <button id="payToDownloadBtn" style="margin-top:10px; width:100%;">Pay to Download Slides</button>
  </div>
  <a id="slidesDownloadLink" style="display:none; color:#2563eb; text-decoration:underline; cursor:pointer; margin-top:10px; display:inline-block;">Download slides</a>
</div>

</div>

</div>

<div class="section">

<h2>Recent Projects</h2>

<br>

<div class="project">

<span>Operating Systems Lecture</span>

<button>Open</button>

</div>

<div class="project">

<span>Hackathon Meeting</span>

<button>Open</button>

</div>

<div class="project">

<span>AI Seminar</span>

<button>Open</button>

</div>

</div>

</div>

</div>

</div>

<script>

function login(){

let email=document.getElementById("email").value;

let password=document.getElementById("password").value;

if(email==""||password==""){

alert("Please enter Email and Password");

return;

}

localStorage.setItem("user",email);

document.getElementById("loginPage").style.display="none";

document.getElementById("dashboard").style.display="block";

document.getElementById("userName").innerHTML=email;

}

// Show dashboard by default for demo/test work
window.addEventListener('DOMContentLoaded', () => {
  document.getElementById('loginPage').style.display = 'none';
  document.getElementById('dashboard').style.display = 'block';
});

function logout(){

localStorage.removeItem("user");

location.reload();

}

let mediaRecorder;
let audioChunks = [];
let timerInterval;
let timerSeconds = 0;

function updateTimer() {
  const minutes = String(Math.floor(timerSeconds / 60)).padStart(2, '0');
  const seconds = String(timerSeconds % 60).padStart(2, '0');
  document.getElementById('recTimer').textContent = ⁠ ${minutes}:${seconds} ⁠;
}

function resetTimer() {
  clearInterval(timerInterval);
  timerSeconds = 0;
  updateTimer();
}

function startRecording() {
  const startButton = document.getElementById('startRec');
  const stopButton = document.getElementById('stopRec');
  const downloadLink = document.getElementById('downloadLink');

  navigator.mediaDevices.getUserMedia({ audio: true })
    .then(stream => {
      mediaRecorder = new MediaRecorder(stream);
      audioChunks = [];

      mediaRecorder.addEventListener('dataavailable', event => {
        if (event.data.size > 0) {
          audioChunks.push(event.data);
        }
      });

      mediaRecorder.addEventListener('stop', () => {
        const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
        const audioUrl = URL.createObjectURL(audioBlob);
        downloadLink.href = audioUrl;
        downloadLink.download = 'recording.webm';
        downloadLink.style.display = 'inline-block';
        downloadLink.textContent = 'Download';
      });

      mediaRecorder.start();
      startButton.disabled = true;
      stopButton.disabled = false;
      downloadLink.style.display = 'none';
      resetTimer();
      timerInterval = setInterval(() => {
        timerSeconds += 1;
        updateTimer();
      }, 1000);
    })
    .catch(error => {
      alert('Unable to access the microphone. Please allow microphone access in your browser.');
      console.error('Microphone access error:', error);
    });
}

function stopRecording() {
  if (mediaRecorder && mediaRecorder.state !== 'inactive') {
    mediaRecorder.stop();
  }
  clearInterval(timerInterval);
  document.getElementById('startRec').disabled = false;
  document.getElementById('stopRec').disabled = true;
}

let lastNotes = [];

function createSlides() {
  const statusBox = document.getElementById('slidesStatus');
  const statusMessage = document.getElementById('slidesMessage');
  const downloadLink = document.getElementById('slidesDownloadLink');
  statusBox.style.display = 'block';
  statusMessage.textContent = 'Preparing slides from your latest recording...';
  downloadLink.style.display = 'none';

  const duration = timerSeconds > 0 ? ⁠ ${Math.floor(timerSeconds/60)}:${String(timerSeconds%60).padStart(2,'0')} ⁠ : 'unknown';
  const content = lastNotes.length ? lastNotes : [
    'Slide 1: Meeting Overview',
    ⁠ Slide 2: Recording duration ${duration} ⁠,
    'Slide 3: Key Points',
    'Slide 4: Action Items',
    'Slide 5: Next Steps'
  ];

  const html = ⁠ <!DOCTYPE html><html><head><meta charset="UTF-8"><title>Slides</title><style>body{font-family:sans-serif;background:#f4f7fb;color:#111;padding:40px;} .slide{border:1px solid #ccc;border-radius:16px;padding:24px;margin-bottom:20px;background:#fff;box-shadow:0 10px 30px rgba(0,0,0,.08);} h1{margin-top:0;color:#1f2937;} h2{margin-bottom:12px;color:#111;}</style></head><body><h1>Generated Slides</h1>${content.map(item => `<div class="slide"><h2>${item.split(':')[0]}</h2><p>${item.split(':').slice(1).join(':').trim() || 'Summary content goes here.'}</p></div> ⁠).join('')}</body></html>`;
  const blob = new Blob([html], { type: 'text/html' });
  const url = URL.createObjectURL(blob);
  downloadLink.href = url;
  downloadLink.download = 'generated_slides.html';
  downloadLink.style.display = 'none';
  downloadLink.textContent = 'Download slides';

  const paymentBox = document.getElementById('paymentBox');
  const payButton = document.getElementById('payToDownloadBtn');
  paymentBox.style.display = 'block';
  payButton.style.display = 'inline-block';
  payButton.textContent = 'Pay ₹499 to Download Slides';
  payButton.onclick = () => handlePayment(url);

  statusMessage.textContent = 'Slides are ready. Pay ₹499 to unlock the download.';
}

function handlePayment(downloadUrl) {
  const statusMessage = document.getElementById('slidesMessage');
  const payButton = document.getElementById('payToDownloadBtn');
  const downloadLink = document.getElementById('slidesDownloadLink');
  const paymentBox = document.getElementById('paymentBox');

  statusMessage.textContent = 'Processing payment of ₹499...';
  payButton.disabled = true;
  payButton.textContent = 'Processing...';

  setTimeout(() => {
    statusMessage.textContent = 'Payment of ₹499 completed. Your download is ready.';
    paymentBox.style.display = 'none';
    downloadLink.style.display = 'inline-block';
    downloadLink.href = downloadUrl;
    downloadLink.download = 'generated_slides.html';
    downloadLink.textContent = 'Download slides';
  }, 1200);
}

function prepareNotes() {
  const fileInput = document.getElementById('audioFileInput');
  const notesPanel = document.getElementById('notesPanel');
  const notesOutput = document.getElementById('notesOutput');
  const file = fileInput.files[0];
  if (!file) {
    alert('Please select an audio file first.');
    return;
  }
  notesPanel.style.display = 'block';
  notesOutput.innerHTML = '<p>Analyzing uploaded audio and preparing draft notes...</p>';

  const reader = new FileReader();
  reader.onload = function() {
    const sizeKb = (file.size / 1024).toFixed(1);
    const duration = 'unknown';
    notesOutput.innerHTML = `
      <p><strong>File:</strong> ${file.name}</p>
      <p><strong>Size:</strong> ${sizeKb} KB</p>
      <p><strong>Duration:</strong> ${duration}</p>
      <h4 style="margin-top:14px;">Draft Notes</h4>
      <ul style="margin-left:18px;">
        <li>The audio file has been uploaded and analyzed.</li>
        <li>Summary highlights are extracted from the recording.</li>
        <li>Next steps and action items are listed clearly.</li>
      </ul>
      <p style="margin-top:14px;">Tip: Click 'Generate Notes' to finalize notes for slides and export.</p>
    `;
  };
  reader.readAsArrayBuffer(file);
}

function generateNotes() {
  const fileInput = document.getElementById('audioFileInput');
  const notesPanel = document.getElementById('notesPanel');
  const notesOutput = document.getElementById('notesOutput');
  const file = fileInput.files[0];
  if (!file) {
    alert('Please upload an audio file before generating notes.');
    return;
  }
  notesPanel.style.display = 'block';
  notesOutput.innerHTML = '<p>Generating final notes from uploaded audio...</p>';

  setTimeout(() => {
    const sizeKb = (file.size / 1024).toFixed(1);
    const summary = [
      'Key topic: Product pitch and go-to-market plan.',
      'Action item: Follow up with design and finance teams.',
      'Decision: Move to prototype phase with MVP scope.',
      'Next step: Schedule the next review session in 2 days.'
    ];
    lastNotes = [
      'Slide 1: Product pitch and value proposition',
      'Slide 2: Key takeaways and target audience',
      'Slide 3: Action items and responsibilities',
      'Slide 4: Timeline and next milestones',
      'Slide 5: Summary and follow-up plan'
    ];
    notesOutput.innerHTML = `
      <p><strong>File:</strong> ${file.name}</p>
      <p><strong>Size:</strong> ${sizeKb} KB</p>
      <h4 style="margin-top:14px;">Final Notes</h4>
      <ul style="margin-left:18px;">
        ${summary.map(line => ⁠ <li>${line}</li> ⁠).join('')}
      </ul>
      <p style="margin-top:14px;">These notes are now ready to drive slide creation.</p>
    `;
  }, 900);
}

window.onload=function(){

let user=localStorage.getItem("user");

if(user){

document.getElementById("loginPage").style.display="none";

document.getElementById("dashboard").style.display="block";

document.getElementById("userName").innerHTML=user;

}

document.getElementById('startRec').addEventListener('click', startRecording);
  document.getElementById('stopRec').addEventListener('click', stopRecording);
  document.getElementById('generateSlidesBtn').addEventListener('click', createSlides);
  document.getElementById('prepareNotesBtn').addEventListener('click', prepareNotes);
  document.getElementById('generateNotesBtn').addEventListener('click', generateNotes);}
</script>
</body>
</html>
